# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and build output
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
SpacedOut/backend/build/

# Environment and secrets
.env
.env.*
!.env.example
*.local
.secrets/*
!.secrets/.gitkeep

# Local databases (the containers keep theirs in Docker volumes)
*.sqlite
*.sqlite3
*.db

# Uploaded avatars
backend/Auth/public/avatars/*
!backend/Auth/public/avatars/.gitkeep

# Editor directories and files
**/.vscode/*
!**/.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

