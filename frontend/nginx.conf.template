map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Plain HTTP only redirects to HTTPS (plus a health endpoint for Docker).
# PUBLIC_HTTPS_PORT is the host port mapped to 443 (substituted by envsubst
# when the container starts; see the Dockerfile).
server {
    listen 80;
    server_name _;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location / {
        return 301 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /etc/ssl/certs/nginx-selfsigned.crt;
    ssl_certificate_key /etc/ssl/private/nginx-selfsigned.key;

    # Avatar uploads are capped at 10 MB by the Auth service.
    client_max_body_size 10m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # External hosts: Babylon default environment and sample textures,
    # MediaPipe (wasm + model) for the SpacedOut vision controls, and
    # generated/Google avatars.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://ui-avatars.com https://*.googleusercontent.com https://assets.babylonjs.com https://playground.babylonjs.com https://www.babylonjs-playground.com; connect-src 'self' https://cdn.jsdelivr.net https://storage.googleapis.com https://assets.babylonjs.com https://playground.babylonjs.com https://www.babylonjs-playground.com; media-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location /api/ {
        proxy_pass http://gateway:3333;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite (not append) so clients cannot spoof their address.
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /avatars/ {
        proxy_pass http://gateway:3333;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite (not append) so clients cannot spoof their address.
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /socket.io/ {
        proxy_pass http://auth:3000/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite (not append) so clients cannot spoof their address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 86400;
    }

    location /spacedout-ws {
        proxy_pass http://spacedout:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite (not append) so clients cannot spoof their address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 86400;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
